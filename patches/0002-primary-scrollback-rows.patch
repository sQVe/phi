    */
   GHOSTTY_TERMINAL_DATA_MEMORY_USAGE = 42,
+
+  /**
+   * The number of scrollback rows of the primary screen, even while the
+   * alternate screen is active.
+   *
+   * Output type: size_t *
+   */
+  GHOSTTY_TERMINAL_DATA_PRIMARY_SCROLLBACK_ROWS = 43,
   GHOSTTY_TERMINAL_DATA_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
 } GhosttyTerminalData;
 
