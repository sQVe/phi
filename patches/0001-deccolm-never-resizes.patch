Make DECCOLM never resize the terminal.

Phi needs this because only the layout sets a pane's size. A program in a
pane must not change it. With this patch DECCOLM still erases the display
and homes the cursor, as tmux does, but keeps the size even with DEC mode 40.

Upstream: https://github.com/ghostty-org/ghostty/blob/83edd491e3024ae5e50393d62877b8897da1cccd/src/terminal/Terminal.zig#L3970

--- a/src/terminal/Terminal.zig
+++ b/src/terminal/Terminal.zig
@@ -3968,25 +3968,12 @@
 /// with the window. This will fix the grid at either 80 or 132 columns.
 /// The rows will continue to be variable.
 pub fn deccolm(self: *Terminal, alloc: Allocator, mode: DeccolmMode) !void {
-    // If DEC mode 40 isn't enabled, then this is ignored. We also make
-    // sure that we don't have deccolm set because we want to fully ignore
-    // set mode.
-    if (!self.modes.get(.enable_mode_3)) {
-        self.modes.set(.@"132_column", false);
-        return;
-    }
-
-    // Enable it
-    self.modes.set(.@"132_column", mode == .@"132_cols");
-
-    // Resize to the requested size
-    try self.resize(alloc, .{
-        .cols = switch (mode) {
-            .@"132_cols" => 132,
-            .@"80_cols" => 80,
-        },
-        .rows = self.rows,
-    });
+    // phi: the pane size belongs to the layout, so DECCOLM
+    // never resizes, even with DEC mode 40. Like tmux, it still erases the
+    // display and homes the cursor.
+    _ = alloc;
+    _ = mode;
+    self.modes.set(.@"132_column", false);
 
     // Erase our display and move our cursor.
     self.eraseDisplay(.complete, false);
